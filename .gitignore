.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
*.egg-info/
dist/
build/

# Node dependencies and build output.
node_modules/
.npm/
.pnpm-store/
.yarn/
frontend/dist/
frontend/build/
.vite/

# Local databases.
*.db
*.sqlite
*.sqlite3
*.db-journal

# Coverage and test output.
.coverage
.coverage.*
coverage/
htmlcov/
.nyc_output/
