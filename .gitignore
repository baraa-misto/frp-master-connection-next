# Licensed/private engineering sources: track only the explanation.
/reference-private/*
!/reference-private/README.md

# Generated artifacts: track only explanations.
/generated/reports/*
!/generated/reports/README.md
/generated/snapshots/*
!/generated/snapshots/README.md

# Environment files and local secrets.
.env
.env.*
!.env.example
*.secret
*.secrets
secrets.*
credentials*.json
service-account*.json

# Credentials, certificates, and keys.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks

