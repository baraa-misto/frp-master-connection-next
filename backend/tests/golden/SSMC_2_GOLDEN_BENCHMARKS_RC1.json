  "invariants": [
    {
      "id": "I01",
      "text": "SSMC has exactly one physical connector plate per instance."
    },
    {
      "id": "I02",
      "text": "The two web attachment groups are serial and never halve the connection action."
    },
    {
      "id": "I03",
      "text": "Global X/Y/Z and signed inclination remain right-handed and backend authoritative."
    },
    {
      "id": "I04",
      "text": "All six wrench components are retained through reference transport."
    },
    {
      "id": "I05",
      "text": "Slice 8 is used only for the bounded planar equal-translational-stiffness component."
    },
    {
      "id": "I06",
      "text": "Inherited axial row fractions are never mixed into the SSMC Slice-8 free-moment solution."
    },
    {
      "id": "I07",
      "text": "Single-sided plate offsets retain generated secondary moments."
    },
    {
      "id": "I08",
      "text": "Unknown single-sided response is never represented as zero."
    },
    {
      "id": "I09",
      "text": "MITER_PLATE_CW_BASIS_UNKNOWN_CUT applies only to the connector plate."
    },
    {
      "id": "I10",
      "text": "The CW policy removes favorable LW strength credit but never makes the plate isotropic."
    },
    {
      "id": "I11",
      "text": "Missing CW properties never fall back to LW."
    },
    {
      "id": "I12",
      "text": "Primary member LW/CW/TT material axes remain unchanged."
    },
    {
      "id": "I13",
      "text": "Actual polygon edges and holes are geometry authority; convex hull/bounding rectangles are not."
    },
    {
      "id": "I14",
      "text": "Polygon resistance remains fail-closed absent qualified authority."
    },
    {
      "id": "I15",
      "text": "Member flange-to-web local transfer remains required local connection scope."
    },
    {
      "id": "I16",
      "text": "Independent hardware authority remains separate from connector material policy."
    },
    {
      "id": "I17",
      "text": "No automatic double-shear multiplier is introduced."
    },
    {
      "id": "I18",
      "text": "Public text/source identifiers cannot create trusted response or material authority."
    },
    {
      "id": "I19",
      "text": "Supported numerical FAIL outranks unresolved qualification blockers."
    },
    {
      "id": "I20",
      "text": "PASS requires complete required local response/resistance/source coverage."
    },
    {
      "id": "I21",
      "text": "SSMC-2 startup cannot imply complete moment-capacity qualification."
    },
