  "invariants": [
    {
      "id": "I01",
      "text": "Every automatic row distribution sums exactly to one and is limited to one through three rows."
    },
    {
      "id": "I02",
      "text": "Under the complete symmetry predicate each incoming member contributes exactly one-half of its signed axial force to each Channel."
    },
    {
      "id": "I03",
      "text": "The two Channel contributions sum exactly to the incoming member force; no force is created or lost."
    },
    {
      "id": "I04",
      "text": "RHS and SRS use one physical full-through shaft per row; W/I uses two distinct physical side shafts per row."
    },
    {
      "id": "I05",
      "text": "A physical shaft is represented and capacity-checked once even when it crosses multiple material layers or produces render aliases."
    },
    {
      "id": "I06",
      "text": "No automatic double-shear hardware-capacity multiplier exists; full-through hardware is checked from actual per-plane demand."
    },
    {
      "id": "I07",
      "text": "The 0.50 closed-section factor changes only the designated RHS characteristic pin-bearing strength and never the applied load, hardware capacity, or unrelated FRP modes."
    },
    {
      "id": "I08",
      "text": "The 0.60 single-lap factor changes only applicable W/I-side FRP in-plane connection strengths and never hardware strength or demand."
    },
    {
      "id": "I09",
      "text": "Solid rectangular members never receive the RHS closed-section 0.50 factor and never become two fictitious walls."
    },
    {
      "id": "I10",
      "text": "When D1 and D2 are both active they have identical section form and complete dimensions, while their inclinations, loads and positions remain independently variable."
    },
    {
      "id": "I11",
      "text": "All active incoming members have one identical gap-fitting dimension; W/I uses overall flange-to-flange depth."
    },
    {
      "id": "I12",
      "text": "Each Channel resultant equals exact reference transport and summation of all qualified incoming half-forces."
    },
    {
      "id": "I13",
      "text": "Any required supported numerical failure remains FAIL even when an independent qualification blocker also exists."
    },
    {
      "id": "I14",
      "text": "An unresolved required shared-Chord cross-group path prohibits local PASS but does not erase already-calculated independent checks or Channel resultants."
    },
    {
      "id": "I15",
      "text": "DCTN creates no connector body and cannot acquire a CME-3 connector-body material target."
    },
    {
      "id": "I16",
      "text": "All sixteen pre-DCTN routes, thirty-nine body identities, existing defaults and frozen FRP/C2/CME-3 provider behavior remain unchanged."
    },
    {
      "id": "I17",
      "text": "Presentation-only unit changes do not alter DCTN topology or method selection; independently executed unit paths retain native numerical representation without normalization."
    },
    {
      "id": "I18",
      "text": "A local DCTN PASS never certifies global Channel member strength, stability, or whole-truss redistribution."
    }
  ]
}
