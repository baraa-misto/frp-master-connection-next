  "invariants": [
    {
      "id": "I01",
      "text": "All accepted C2-R response modes preserve full force/moment provenance and never infer missing material-dependent response."
    },
    {
      "id": "I02",
      "text": "ASCE74 FRP-steel prescribed row fractions sum exactly to one and are available only for two or three rows."
    },
    {
      "id": "I03",
      "text": "A common physical fastener shaft is counted once and ordered layer/cut forces close exactly."
    },
    {
      "id": "I04",
      "text": "Source-total bolt tension that already includes prying is never multiplied or incremented by a second prying factor."
    },
    {
      "id": "I05",
      "text": "Changing actual material/product/section/response authority changes the canonical fingerprint or fails closed."
    },
    {
      "id": "I06",
      "text": "Display unit changes and ambient Decimal context cannot change physical result, status, governing branch, or fingerprint."
    },
    {
      "id": "I07",
      "text": "AISC 370 Curve A used stress never exceeds Fy because the frozen project cap min(Fy,Fn_raw) is retained."
    },
    {
      "id": "I08",
      "text": "For G6, 0 < Cv2 <= 1.2 and increasing resisting area at fixed Cv2 cannot reduce available pure-shear resistance."
    },
    {
      "id": "I09",
      "text": "F10 nominal flexural strength never exceeds Fy*Smin."
    },
    {
      "id": "I10",
      "text": "Within an approved F10 inelastic stability record, increasing Lb cannot increase available flexural strength."
    },
    {
      "id": "I11",
      "text": "Increasing any positive H2 demand term cannot reduce the governing interaction."
    },
    {
      "id": "I12",
      "text": "D3 shear-lag factor remains within 0 < U <= 1; angle Case 8 is not applied to Tees."
    },
    {
      "id": "I13",
      "text": "Nonzero torsion or combined normal-plus-shear action never receives a C2-A/C2-T RC1 combined resistance."
    },
    {
      "id": "I14",
      "text": "Unqualified contact, prying, stiffness sharing, or response redistribution never receives an authoritative envelope."
    },
    {
      "id": "I15",
      "text": "Frozen C2-M/C2-P1/C2-P2 production behavior and fingerprints remain exact."
    },
    {
      "id": "I16",
      "text": "No isolated C2-R/C2-A/C2-T PASS activates public SS316 family dispatch or changes FRP/hardware/foundation authority."
    }
