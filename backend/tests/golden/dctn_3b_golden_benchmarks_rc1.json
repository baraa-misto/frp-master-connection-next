  "invariants": [
    {
      "id": "I01",
      "text": "DCTN-3B relative placement stores s and h; global START is derived."
    },
    {
      "id": "I02",
      "text": "Changing Channel depth preserves s and h and reruns all geometry/hardware validators."
    },
    {
      "id": "I03",
      "text": "The lower usable-web datum is placement geometry only and never an ASCE free edge or Channel centroid/shear center."
    },
    {
      "id": "I04",
      "text": "DCTN-2 historical payloads are never silently reinterpreted as DCTN-3B."
    },
    {
      "id": "I05",
      "text": "Nonzero-Y legacy placement is never silently flattened to the mid-gap."
    },
    {
      "id": "I06",
      "text": "Canonical physical action storage is P/Qp/Qq, independent of changing major/minor labels."
    },
    {
      "id": "I07",
      "text": "u,p,q remain right-handed and q is the DCTN cross-gap +Y direction."
    },
    {
      "id": "I08",
      "text": "Exact generated moments from P/Qp/Qq transport are retained."
    },
    {
      "id": "I09",
      "text": "Qp=Qq=0 dispatches the historical DCTN-2 axial response exactly."
    },
    {
      "id": "I10",
      "text": "Any nonzero Qp or Qq cannot receive automatic DCTN transverse response without trusted authority."
    },
    {
      "id": "I11",
      "text": "An unresolved transverse response is never serialized or displayed as zero."
    },
    {
      "id": "I12",
      "text": "Slice 8 cannot determine Channel sharing and cannot replace historical axial row fractions."
    },
    {
      "id": "I13",
      "text": "Trusted response is server-bound to exact geometry/actions/material/hardware/source/version and cannot be activated by user text."
    },
    {
      "id": "I14",
      "text": "A response validator proves closure/coverage but does not solve unknown reactions."
    },
    {
      "id": "I15",
      "text": "Equal-axis RHS/SRS displays p/q labels and does not invent a major axis."
    },
    {
      "id": "I16",
      "text": "Changing rectangular proportions may change major/minor labels but never silently swaps stored Qp/Qq."
    },
    {
      "id": "I17",
      "text": "Normal result formatting is presentation-only; exact native values remain in engineering trace."
    },
    {
      "id": "I18",
      "text": "Invalid current geometry uses LAST VALID presentation, hides stale action arrows and disables current design."
    },
    {
      "id": "I19",
      "text": "DCTN remains a no-body route and all C2/CME-3 body-provider isolation is preserved."
    },
    {
      "id": "I20",
      "text": "No route/body/workspace/selector inventory count changes in DCTN-3B."
    },
    {
      "id": "I21",
      "text": "All pre-DCTN routes and current DCTN-2 P-only parent responses remain exact per native unit path."
    },
    {
      "id": "I22",
      "text": "A numerical supported failure still outranks unresolved response/source qualification."
    }
  ]
}
