  "invariants": [
    {
      "id": "I01",
      "text": "Absent connector-body material selection and explicit FRP selection are numerically and semantically identical to the frozen historical FRP path."
    },
    {
      "id": "I02",
      "text": "Exactly 13 routes expose connector-body material selection; exactly three no-body routes do not."
    },
    {
      "id": "I03",
      "text": "The canonical route-qualified body inventory remains exactly 39: 21 ANGLE, 16 PLATE, 2 TEE."
    },
    {
      "id": "I04",
      "text": "Selecting SS316 never changes primary-member material; every primary member remains FRP_ONLY."
    },
    {
      "id": "I05",
      "text": "Selecting SS316 never changes bolt/nut/washer, anchor, concrete, support or foundation numerical authority."
    },
    {
      "id": "I06",
      "text": "No SS316 body request may fall back to an FRP connector-body resistance provider."
    },
    {
      "id": "I07",
      "text": "A supported numerical failure remains visible even when separate qualification blockers also exist."
    },
    {
      "id": "I08",
      "text": "Whole-connection PASS requires every required evaluated check to pass and no required qualification/source/applicability blocker."
    },
    {
      "id": "I09",
      "text": "Material planning does not execute resistance and therefore does not populate design capacity/utilization."
    },
    {
      "id": "I10",
      "text": "Changing connector-body material is design-affecting, changes the activation fingerprint, and stales prior design results."
    },
    {
      "id": "I11",
      "text": "Display-unit changes do not change physical activation, provider selection, result, status, governing check or canonical fingerprint."
    },
    {
      "id": "I12",
      "text": "Frozen C2-M/P1/P2/R/A/T provider outputs and fingerprints are not modified by CME-3 activation."
    },
    {
      "id": "I13",
      "text": "The CME-3 wrapper may activate a frozen isolated provider publicly without mutating that provider's own frozen family_activation field."
    },
    {
      "id": "I14",
      "text": "Unsupported response/product/stability/torsion/prying/junction conditions fail closed and never receive fabricated capacity."
    },
    {
      "id": "I15",
      "text": "Historical Tee startup/default invalid geometry remains exact and is never repaired by material selection."
    },
    {
      "id": "I16",
      "text": "All pre-CME-3 FRP native responses remain exact except for deliberately changed readiness/capability/material-selection metadata."
    },
    {
      "id": "I17",
      "text": "RC1 uses one connection-wide connector-body material selection; mixed FRP/SS316 connector bodies within one connection are unsupported."
    },
    {
      "id": "I18",
      "text": "Public clients cannot manufacture trusted C2 response/source/section/local-region authority through hashes, flags or arbitrary records."
    }
  ]
